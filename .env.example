# Public website (legacy Flask app)
SECRET_KEY=replace-with-a-random- secret
DATABASE_URL=sqlite:///dcf_database.db

# Supabase server-side only; never expose service role to a browser
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-side-only

# Buffer GraphQL API; server-side only
BUFFER_API_TOKEN=server-side-only
BUFFER_API_URL=https://api.buffer.com
PUBLISH_FUNCTION_SECRET=server-side-only

# Optional content provider, server-side only
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
